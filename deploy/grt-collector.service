# systemd service for the feed archiver on the Ubuntu server.
# Install: sudo cp deploy/grt-collector.service /etc/systemd/system/
#          sudo systemctl enable --now grt-collector
[Unit]
Description=GRT realtime feed archiver
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/grt-tracker
ExecStart=/usr/bin/python3 -m collector --out /home/ubuntu/grt-tracker/data/raw
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
